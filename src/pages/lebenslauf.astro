---
import "../styles/fonts.css";
import { fullName, email, socials, cvPdf, experience, education, skills, projects, languages } from "../data";

// Der Lebenslauf ist deutsch (Bewerbungen bei deutschen Betrieben). Beim Deploy wird diese Seite zu /lebenslauf.pdf gedruckt.
const de = <T extends { de: string }>(text: T) => text.de;
const stand = new Intl.DateTimeFormat("de-DE", { month: "long", year: "numeric" }).format(new Date());
const site = Astro.site!;
const short = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
// Neueste Station zuerst, wie im Lebenslauf üblich.
const steps = [...experience].reverse();
---
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lebenslauf — {fullName}</title>
<meta name="description" content={`Lebenslauf von ${fullName}, Azubi zum Fachinformatiker für Systemintegration in Hamburg.`}>
<meta name="robots" content="noindex">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>

<div class="toolbar">
  <a href="/">← Portfolio</a>
  <a href={cvPdf} download="Lebenslauf-Louis-Lastella.pdf">PDF herunterladen</a>
</div>

<main class="sheet">
  <header class="cv-head">
    <h1>{fullName}</h1>
    <p class="cv-role">Auszubildender Fachinformatiker für Systemintegration</p>
    <p class="cv-contact">
      <span>Hamburg</span>
      <a href={`mailto:${email}`}>{email}</a>
      <a href={site.href}>{short(site.href)}</a>
      <a href={socials.github}>{short(socials.github)}</a>
    </p>
  </header>

  <section>
    <h2>Werdegang</h2>
    {steps.map((s) => (
      <div class="entry">
        <span class="entry-dates">{de(s.dates)}</span>
        <div>
          <h3>{de(s.role)} <span class="entry-org">· {de(s.company)}</span></h3>
          <p>{de(s.desc)}</p>
        </div>
      </div>
    ))}
  </section>

  {education.length > 0 && (
    <section>
      <h2>Schulbildung</h2>
      {education.map((s) => (
        <div class="entry">
          <span class="entry-dates">{de(s.dates)}</span>
          <div>
            <h3>{de(s.role)} <span class="entry-org">· {de(s.company)}</span></h3>
            <p>{de(s.desc)}</p>
          </div>
        </div>
      ))}
    </section>
  )}

  <section>
    <h2>Kenntnisse</h2>
    {skills.map((s) => (
      <div class="entry">
        <span class="entry-dates">{de(s.title)}</span>
        <p>{s.items.join(" · ")}</p>
      </div>
    ))}
    {languages.length > 0 && (
      <div class="entry">
        <span class="entry-dates">Sprachen</span>
        <p>{languages.map((l) => `${l.name} (${l.level})`).join(" · ")}</p>
      </div>
    )}
  </section>

  <section>
    <h2>Projekte</h2>
    {projects.map((p) => (
      <div class="entry project">
        <span class="entry-dates">{p.tags.slice(0, 2).join(" · ")}</span>
        <div>
          <h3>{p.title} {p.url && <a class="entry-org" href={p.url}>· {short(p.url)}</a>}</h3>
          <p>{de(p.desc)}</p>
        </div>
      </div>
    ))}
  </section>

  <footer class="cv-foot">Stand {stand} · aktuelle Fassung und Projekte auf {short(site.href)}</footer>
</main>

<style is:global>
  :root { --ink: #1b1a19; --soft: #5c5a57; --line: #e4e1dc; --accent: #c41c40; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { color-scheme: light; -webkit-text-size-adjust: 100%; }
  body { background: #0a0a0a; color: var(--ink); font-family: 'DM Sans', system-ui, sans-serif; font-size: 10pt; line-height: 1.5; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .toolbar { display: flex; justify-content: space-between; max-width: 210mm; margin: 0 auto; padding: 20px 4px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: #999794; }
  .toolbar a:last-child { color: #f0496b; }

  .sheet { max-width: 210mm; margin: 0 auto 48px; padding: 18mm 18mm 14mm; background: #fff; }
  .cv-head { padding-bottom: 6mm; margin-bottom: 6mm; border-bottom: 1px solid var(--line); }
  .cv-head h1 { font-family: 'Bebas Neue', 'Arial Narrow', sans-serif; font-weight: 400; font-size: 34pt; line-height: 0.95; letter-spacing: 0.01em; }
  .cv-head h1::before { content: ''; display: block; width: 10mm; height: 2px; margin-bottom: 4mm; background: var(--accent); }
  .cv-role { margin-top: 2mm; font-size: 11pt; font-weight: 450; }
  .cv-contact { display: flex; flex-wrap: wrap; gap: 0 5mm; margin-top: 2mm; color: var(--soft); font-size: 9pt; }

  section { margin-bottom: 5mm; }
  h2 { font-family: 'Bebas Neue', 'Arial Narrow', sans-serif; font-weight: 400; font-size: 15pt; letter-spacing: 0.04em; color: var(--accent); margin-bottom: 2mm; }
  .entry { display: grid; grid-template-columns: 38mm 1fr; gap: 5mm; padding: 2mm 0; border-top: 1px solid var(--line); break-inside: avoid; }
  .entry-dates { font-size: 8pt; font-weight: 450; letter-spacing: 0.06em; text-transform: uppercase; color: var(--soft); padding-top: 0.6mm; }
  h3 { font-size: 10pt; font-weight: 600; }
  .entry-org { font-weight: 400; color: var(--soft); }
  .entry p { color: #33312f; }
  .cv-foot { margin-top: 6mm; padding-top: 3mm; border-top: 1px solid var(--line); font-size: 8pt; color: var(--soft); }

  @media (max-width: 640px) {
    .sheet { padding: 24px 20px; }
    .entry { grid-template-columns: 1fr; gap: 2px; }
  }
  @page { size: A4; margin: 15mm 0 14mm; }
  @media print {
    body { background: #fff; }
    .toolbar { display: none; }
    .sheet { margin: 0; max-width: none; padding: 0 18mm; }
  }
</style>
</body>
</html>
