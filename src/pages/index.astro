---
import { existsSync } from "node:fs";
import "../styles/global.css";
import { name, initials, city, email, yearsExp, photo, socials, skills, experience, projects, marqueeItems, typedWords } from "../data";

// Bilder liegen unter public/. Ein falscher Dateiname bricht den Build ab statt still ein kaputtes Bild zu zeigen.
const publicFile = (path: string) => {
  if (!existsSync(`public${path}`)) throw new Error(`Bild fehlt: public${path}`);
  return path;
};
const projectImage = (file?: string) => (file ? publicFile(`/assets/images/projects/${file}`) : "");
const linkLabel = (url: string) => (url.includes("github.com") ? "Repo ansehen" : "Website öffnen");
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{name} — Portfolio</title>
<meta name="description" content={`Portfolio von ${name}, Fachinformatiker für IT-Systemintegration in Ausbildung. Web Design, PHP-Entwicklung und IT-Projekte.`}>
<meta property="og:title" content={`${name} — Portfolio`}>
<meta property="og:description" content="Fachinformatiker für IT-Systemintegration in Ausbildung. Web Design, PHP-Entwicklung und IT-Projekte.">
<meta property="og:type" content="website">
<meta property="og:image" content={new URL(photo, Astro.site).href}>
<meta name="theme-color" content="#0a0a0a">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preload" href="/assets/fonts/bebas-neue-latin.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>

<a class="skip-link" href="#main">Zum Inhalt springen</a>

<nav id="navbar">
  <a href="#" class="nav-logo" aria-label="Nach oben">{name[0]}<span>.</span></a>
  <ul class="nav-links">
    <li class="nav-extra"><a href="#about">Über mich</a></li>
    <li class="nav-extra"><a href="#skills">Skills</a></li>
    <li class="nav-extra"><a href="#experience">Erfahrung</a></li>
    <li><a href="#projects">Projekte</a></li>
    <li><a href="#contact">Kontakt</a></li>
  </ul>
</nav>

<main id="main">

<section class="hero" id="home">
  <h1 class="hero-headline">
    <span class="line">Ich bin</span>
    <span class="line typed" id="typedEl" aria-hidden="true" data-words={JSON.stringify(typedWords)}>{typedWords[0]}</span>
    <span class="sr-only">{typedWords[0]}</span>
    <span class="line">Azubi &amp;</span>
    <span class="line">Web-Enthusiast.</span>
  </h1>
  <p class="hero-sub">18 Jahre alt, Azubi in Hamburg — und gerade dabei, das Webbauen für mich zu entdecken.</p>
  <div class="hero-actions">
    <a href="#projects" class="btn-primary">Projekte ansehen</a>
    <a href="#contact" class="btn-ghost">
      Kontakt aufnehmen
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[...marqueeItems, ...marqueeItems].map((item) => <span class="marquee-item">{item}</span>)}
  </div>
</div>

<section id="about">
  <div class="about">
    <figure class="about-visual" data-reveal>
      <div class="about-frame">
        {photo
          ? <img src={publicFile(photo)} alt={`${name} als Kind`} width="640" height="640">
          : <div class="about-initials" aria-hidden="true">{initials}</div>}
      </div>
      <div class="about-badge">In<br>Ausbildung</div>
    </figure>
    <div class="about-text">
      <h2 class="section-title" data-reveal>Hallo, ich bin Louis.</h2>
      <p>Ich bin 18, wohne in Hamburg und mache gerade meine Ausbildung zum Fachinformatiker für IT-Systemintegration. Technik begeistert mich schon lange — Netzwerke, Hardware, Software, wie alles zusammenhängt.</p>
      <p>Seit 2025 lerne ich auch Web Design und Frontend-Entwicklung. Diese Seite hier ist mein erstes eigenes Projekt — noch lange nicht fertig, aber ich arbeite dran.</p>
      <dl class="about-stats">
        <div class="stat" data-reveal><dt>Jahre in der IT</dt><dd>{yearsExp}+</dd></div>
        <div class="stat" data-reveal><dt>Eigene Projekte</dt><dd>{projects.length}</dd></div>
        <div class="stat" data-reveal><dt>Abschluss</dt><dd>2028</dd></div>
      </dl>
    </div>
  </div>
</section>

<section id="skills">
  <h2 class="section-title" data-reveal>Was ich lerne &amp; kann</h2>
  <div class="skills-grid">
    {skills.map((skill) => (
      <div class="skill" data-reveal>
        <h3>{skill.title}</h3>
        <p>{skill.desc}</p>
        <ul class="skill-list">
          {skill.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<section id="experience">
  <h2 class="section-title" data-reveal>Mein Weg</h2>
  <ol class="timeline" data-reveal>
    {experience.map((e, i) => (
      <li class:list={["timeline-entry", i % 2 === 0 ? "left" : "right"]} data-reveal>
        <span class="timeline-dates">{e.dates}</span>
        <h3 class="timeline-role">{e.role}</h3>
        <span class="timeline-company">{e.company}</span>
        <p class="timeline-desc">{e.desc}</p>
      </li>
    ))}
  </ol>
</section>

<section id="projects">
  <h2 class="section-title" data-reveal>Projekte</h2>
  <div class="projects-grid">
    {projects.map((p) => {
      const img = projectImage(p.image);
      return (
        <article class:list={["project", { "has-link": p.url }]} data-reveal>
          {img && <img class="project-image" src={img} alt="" loading="lazy">}
          <h3>
            {p.url
              ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a>
              : p.title}
          </h3>
          <div class="project-body">
            <p class="project-desc">{p.desc}</p>
            <div class="project-meta">
              <ul class="project-tags">
                {p.tags.map((tag) => <li class="tag">{tag}</li>)}
              </ul>
              {p.url && <span class="project-link" aria-hidden="true">{linkLabel(p.url)} <span class="arrow">→</span></span>}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<section class="contact" id="contact">
  <h2 data-reveal><span class="line">Meld</span> <span class="line">dich.</span></h2>
  <p>Ich freue mich über jede Nachricht — egal ob Frage, Austausch oder einfach Hallo.</p>
  <div class="contact-links">
    <a href={`mailto:${email}`} class="contact-link" data-reveal>E-Mail schreiben</a>
    <a href={socials.github} class="contact-link" data-reveal target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href={socials.discord} class="contact-link" data-reveal target="_blank" rel="noopener noreferrer">Discord</a>
  </div>
</section>

</main>

<footer>
  <span>© {year} {name}</span>
  <a href={`mailto:${email}`}>{email}</a>
  <span>{city}</span>
</footer>

<script>
  /* === NAV: border on scroll, underline the section in view === */
  const nav = document.getElementById("navbar")!;
  const navLinks = nav.querySelectorAll<HTMLAnchorElement>(".nav-links a");
  const sections = [...document.querySelectorAll<HTMLElement>("main section[id]")];
  const onScroll = () => {
    nav.classList.toggle("scrolled", window.scrollY > 40);
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    const current = atBottom ? sections.at(-1) : sections.findLast((s) => s.getBoundingClientRect().top < window.innerHeight * 0.4);
    navLinks.forEach((a) => a.classList.toggle("active", a.hash === `#${current?.id}`));
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  /* === TYPED WORD (starts from the server-rendered first word) === */
  const typed = document.getElementById("typedEl");
  const words: string[] = JSON.parse(typed?.dataset.words ?? "[]");
  if (typed && words.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let wi = 0, ci = words[0].length, deleting = true;
    const step = (): void => {
      const word = words[wi];
      typed.textContent = word.slice(0, deleting ? --ci : ++ci);
      if (!deleting && ci === word.length) { deleting = true; setTimeout(step, 2200); return; }
      if (deleting && ci === 0) { deleting = false; wi = (wi + 1) % words.length; setTimeout(step, 300); return; }
      setTimeout(step, deleting ? 55 : 105);
    };
    setTimeout(step, 2600);
  }

  /* === SCROLL REVEAL: [data-reveal] gets .in once on screen; elements arriving together are staggered via --d === */
  const reveal = new IntersectionObserver((entries) => {
    let n = 0;
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const el = entry.target as HTMLElement;
      el.style.setProperty("--d", `${Math.min(n++, 4) * 90}ms`);
      el.classList.add("in");
      reveal.unobserve(el);
    }
  }, { rootMargin: "0px 0px -8% 0px" });
  document.querySelectorAll("[data-reveal]").forEach((el) => reveal.observe(el));
</script>
</body>
</html>
